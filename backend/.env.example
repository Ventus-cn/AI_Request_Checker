AI_MODE=mock
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
PORT=8080

# Vision requires AI_MODE=qwen, a valid key and access to this multimodal model.
VISION_ENABLED=true
QWEN_VISION_MODEL=qwen-vl-max
VISION_MAX_UNITS=30
# Optional separate OpenAI-compatible vision endpoint (defaults to QWEN_URL).
# QWEN_VISION_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Optional CJK TTF font; Windows automatically uses SimHei/SimFang.
# PDF_FONT_PATH=C:/Windows/Fonts/simhei.ttf
